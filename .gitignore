# Market data is never committed (provider terms forbid redistribution)
data/

# Secrets
.env

# Model checkpoints: only the final model and its thresholds are committed,
# so the service runs without retraining (weights only, no market data)
checkpoints/*
!checkpoints/autoencoder.pt
!checkpoints/thresholds.json

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# macOS
.DS_Store
